# ============================================================
# .env.example — Copy this to .env and fill in values
# ============================================================
# ⚠️  NEVER commit .env to Git. It's in .gitignore.
# ⚠️  This file (.env.example) IS safe to commit — it has no real values.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (AWS RDS PostgreSQL) ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://admin:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/whatsapp_analyzer

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRY=7d

# --- AWS S3 (for storing uploaded .txt files) ---
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET_NAME=whatsapp-analyzer-uploads
AWS_REGION=ap-south-1

# --- OpenRouter (AI Gateway) ---
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# --- Langfuse (AI Observability) ---
# Get from: https://us.cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- App URL (for OpenRouter HTTP-Referer header) ---
SITE_URL=http://localhost:5173
